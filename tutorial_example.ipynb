    "# Listing 1\n",
    "from openai import OpenAI\n",
    "\n",
    "#client = OpenAI(api_key=\"your_api_key_here\")\n",
    "client = OpenAI()\n",
    "\n",
    "response = client.responses.create(\n",
    "    model=\"gpt-5.4-2026-03-05\",\n",
    "    input=\"What are the FDA's key purposes?\"\n",
    ")\n",
    "\n",
    "print(response.output_text)"
   ]
